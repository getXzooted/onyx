#!/bin/bash

# ==============================================================================
#                             ONYX CLI CONTROLLER
#                 The central command hub for the Onyx Gateway.
# ==============================================================================

# 1. ESTABLISH ROOT CONTEXT
# We use readlink to find the actual project folder, even if this script is a symlink.
if [ -d "/opt/onyx" ]; then
    export ONYX_ROOT="/opt/onyx"
else
    # Fallback to dynamic detection for development/custom installs
    CURRENT_SCRIPT_PATH="$(readlink -f "$0")"
    # If the script is in bin/, we need to go up one level to reach the root
    export ONYX_ROOT="$(dirname "$(dirname "$CURRENT_SCRIPT_PATH")")"
fi

# If dynamic detection failed (root is empty or root), force the standard path
if [[ -z "$ONYX_ROOT" ]] || [[ "$ONYX_ROOT" == "/" ]]; then
    export ONYX_ROOT="/opt/onyx"
fi

# 2. LOAD ENVIRONMENT
if [ ! -f "$ONYX_ROOT/env.sh" ]; then
    echo "CRITICAL ERROR: Environment file not found at $ONYX_ROOT/env.sh"
    exit 1
else
    source "$ONYX_ROOT/env.sh"
fi

# 3. ROOT CHECK
if [[ $EUID -ne 0 ]]; then
   log_error "Onyx must be run as root. Try: sudo onyx $1"
   exit 1
fi

# 4. COMMAND ROUTER
if [ -f "$LIB_DIR/onyx/commands.sh" ]; then
    source "$LIB_DIR/onyx/commands.sh"
else
    log_error "Onyx commands module not found at $LIB_DIR/onyx/commands.sh"
    log_info "Please ensure lib/onyx/commands.sh exists."
    exit 1
fi